# Credenciales SMTP de Zoho Mail para el formulario de contacto
# (app/api/contacto/route.js). Configura estas mismas variables en
# Vercel: Project Settings -> Environment Variables.
#
# ZOHO_APP_PASSWORD es una contraseña de aplicación generada desde
# Zoho Mail (Configuracion de cuenta -> Seguridad -> Contraseñas de
# aplicacion), NO la contraseña normal de la cuenta.

ZOHO_EMAIL=
ZOHO_APP_PASSWORD=
